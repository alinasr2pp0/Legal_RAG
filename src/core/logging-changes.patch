+@app.middleware("http")
+async def request_log(request: Request, call_next):  # type: ignore[no-untyped-def]
+    """Correlation id + one access line per request (no query strings, no bodies)."""
+    rid = request.headers.get("X-Request-ID") or uuid.uuid4().hex[:12]
+    token = request_id_var.set(rid)
+    start = time.perf_counter()
+    try:
+        response = await call_next(request)
+    except Exception:
+        logger.exception("%s %s -> unhandled error", request.method, request.url.path)
+        raise
+    finally:
+        request_id_var.reset(token)
+    response.headers["X-Request-ID"] = rid
+    if request.url.path not in _QUIET_PATHS:
+        ms = (time.perf_counter() - start) * 1000
+        level = logging.WARNING if response.status_code >= 500 else logging.INFO
+        logger.log(
+            level, "%s %s -> %d (%.0f ms)", request.method, request.url.path,
+            response.status_code, ms, extra={},
+        )
+    return response
+
+
+_QUIET_PATHS = {"/metrics", "/health", "/favicon.ico"}
