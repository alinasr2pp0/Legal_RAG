# انسخ الملف:  cp .env.example .env   ثم ضع مفاتيحك أنت في .env فقط (لا تشاركها ولا ترفعها إلى git)
# هذا الإعداد محلي بالكامل: embedding محلي + Ollama + Qdrant مضمّن.
# أي متغير هنا يتغلب على الـ profile.

PROVIDER_PROFILE=local            # config/providers.yaml: local | local_full
LOCAL_ONLY=true

# --- Embedding ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small     # 384-d، بادئات query:/passage: تُضاف تلقائيًا
# لو النموذج محمّل على جهازك: ضع مسار المجلد بدل الاسم (مجلد sentence-transformers كامل فيه modules.json):
# EMBEDDING_MODEL=D:/AI-Models/multilingual-e5-small   # مجلدك الحالي كامل (modules.json + 1_Pooling + model.safetensors)
# EMBEDDING_E5_PREFIXES=true      # فقط لو اسم المجلد لا يحتوي e5
LOCAL_EMBEDDING_BATCH_SIZE=16
MODELS_DIR=./models               # كاش HuggingFace؛ نزّله مرة: python scripts/data/download_models.py
HF_OFFLINE=true                   # بعد التحميل لا اتصال بـ HuggingFace (اجعله false في أول تشغيل لو لم تنزّل)

# --- Rerank محليًا باستخدام الترتيب المدمج ---
RERANKER_ENABLED=false
VOYAGE_API_KEY=                   # مفتاحك أنت
VOYAGE_RERANK_MODEL=rerank-2.5    # أو rerank-2.5-lite
RERANKER_REQUIRED=false           # true => يفشل التشغيل لو الـ reranker غير متاح بدل التراجع للترتيب المدمج

# --- LLM: Ollama (واجهة OpenAI-compatible). المفتاح أي نص غير فارغ ---
LLM_MODEL_PRIMARY=qwen2.5:3b                # الوسم كما يظهر في `ollama list` (هو نفس نموذج instruct)؛ اسحبه مرة: ollama pull qwen2.5:3b
LLM_BASE_URL=http://localhost:11434/v1      # داخل compose يُستبدل بـ host.docker.internal
LLM_API_KEY=ollama

# --- بحث الويب (Tavily): احتياطي بقيود قانونية صارمة ---
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=                   # مفتاحك أنت؛ بدونه يبقى البحث الخارجي معطّلًا

# --- Qdrant: embedded محليًا، أو سيرفر (داخل compose يُستبدل بـ http://qdrant:6333) ---
QDRANT_PATH=./data/qdrant
# QDRANT_URL=http://localhost:6333

# --- الأمان وملفات القضية ---
PII_REDACTION_ENABLED=true
CASE_UPLOAD_ENABLED=true

# --- تتبّع (اختياري) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091

# --- Docker Hub (اختياري) ---
# DOCKERHUB_USERNAME=youruser     # اسم صورتك على Docker Hub (compose يسحبها لو موجودة وإلا يبنيها)
# CORS_ORIGINS=["http://localhost:5173"]
